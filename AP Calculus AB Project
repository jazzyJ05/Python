# Model

shape_var = tk.StringVar()
shape_var.set("square")

def cross_section_graph():
    try:
        f = get_expression()

        a = float(lower_entry.get())
        b = float(upper_entry.get())
        n = int(subinterval_entry.get())

        shape = shape_var.get()

        x_vals = np.linspace(a,b,n)
        fig, ax = plt.subplots()

        ax.set_xlim(a,b)
        max_height = max(float(f.subs(x,val))for val in x_vals)
        ax.set_ylim(0,max_height+1)

        for x0 in x_vals:
            h = float(f.subs(x,x0))
            if h<0:
                continue

            width = (b-a)/n *0.8

            if shape == "square":
                ys = [0, h, h, 0]
                xs = [x0,x0,x0+width,x0+width]
                ax.fill(xs,ys,alpha=0.5)
            elif shape == "semicircle":
                theta = np.linspace(0,np.pi, 30)
                radius = h

                xs = x0 + width/2 + (radius * np.cos(theta))
                ys = radius * np.sin(theta)
                ax.fill(xs,ys,alpha=0.5)
            elif shape == "triangle":
                xs= [x0,x0+width/2,x0+width]
                ys=[0,h,0]
                ax.fill(xs,ys,alpha=0.5)
            else:  
                continue
        
        ax.set_title("Cross Section Shapes Along f(x)")
        ax.set_aspect('auto')
        plt.show()

    except Exception as e:
        result_label.config(text=str(e))


