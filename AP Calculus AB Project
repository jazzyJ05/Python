import math
import sympy as sym
from sympy import Symbol, integrate

import matplotlib.pyplot as plt
import numpy as np
import tkinter as tk

from sympy.parsing.sympy_parser import(parse_expr, standard_transformations, implicit_multiplication_application)
transformations = (standard_transformations + (implicit_multiplication_application,))

def get_expression():
    expression = function_entry.get()
    expression = expression.replace("^","**")
    playerfunc = parse_expr(expression,transformations=transformations) 
    return playerfunc



x = sym.symbols('x')

def integralcalcwithbounds():
    try:
        playerfunc=get_expression()
        lowerbound = float(lower_entry.get())
        upperbound = float(upper_entry.get())
        subintervals = int(subinterval_entry.get())

        delta_x = (upperbound - lowerbound) / subintervals
        
        total_sum = 0 

        for n in range(1,subintervals+1):

            midpoint = lowerbound + (n-0.5) * delta_x
            total_sum += playerfunc.subs(x,midpoint)

        answer = delta_x * total_sum    
        
        result_label.config(text=str(answer))

    except Exception as e:
       result_label.config(text=str(e))

def integralcalcwithoutbounds():
    try:
        playerfunc=get_expression()
        result = sym.integrate(playerfunc,x)
        result_label.config(text=str(integrate(playerfunc,x)).replace("**","^"))
    except Exception as e:
       result_label.config(text=str(e))


def derivativecalc():
  # Derivative Calcultaor
    try:
        playerfunc=get_expression()
        derivative = sym.diff(playerfunc,x)
        result_label.config(text=str(derivative).replace("**","^"))
    except Exception as e:
       result_label.config(text=str(e))


